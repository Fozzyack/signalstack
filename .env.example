# Server-only credentials. Do not prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://signalstack:signalstack_dev@localhost:5432/signalstack
# Production: use a pooled DATABASE_URL and a direct connection for migrations.
# DATABASE_MIGRATION_URL=postgresql://...
# Optional canonical origin for deployments behind a reverse proxy.
# APP_URL=https://signalstack.example.com

# Local Docker services. Change DATABASE_URL too when changing POSTGRES_PORT.
POSTGRES_PORT=5432
SMTP_PORT=1025
MAILPIT_PORT=8025
# Mailpit is available for future email features; no emails are currently sent.
# SEED_PASSWORD=signalstack-dev
